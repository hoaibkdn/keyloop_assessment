    "/appointments": {
      "post": {
        "summary": "Book a service appointment",
        "tags": [
          "appointments"
        ],
        "description": "Checks that a qualified technician and a service bay are both free for the full service duration, auto-assigns them, and persists a CONFIRMED appointment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dealershipId",
                  "customerId",
                  "vehicleId",
                  "serviceTypeId",
                  "startTime"
                ],
                "properties": {
                  "dealershipId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "customerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "vehicleId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "serviceTypeId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "startTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO-8601 with offset, aligned to 15 minutes, e.g. 2026-11-03T09:00:00Z"
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "description": "Optional. Retrying with the same key returns the original appointment instead of double-booking."
          }
        ],
        "responses": {
          "200": {
            "description": "Idempotent replay of an earlier identical request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "dealershipId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "customerId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "vehicleId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "serviceTypeId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "technicianId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "serviceBayId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "startTime": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "endTime": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "CONFIRMED",
                        "CANCELLED"
                      ]
                    },
                    "notes": {
                      "type": "string",
                      "nullable": true
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "cancelledAt": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    }
                  },
                  "description": "Idempotent replay of an earlier identical request"
                }
              }
            }
          },
