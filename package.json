{
  "name": "service-scheduler",
  "version": "1.0.0",
  "description": "Keyloop Unified Service Scheduler - appointment booking API with resource-constrained availability",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
